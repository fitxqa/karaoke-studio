# Copy to .env and edit.
# Leave KARAOKE_API_KEY empty when you only use the app on this PC.
# Set it to a long secret when the server is on the internet.
KARAOKE_API_KEY=
DEMUCS_MODEL=htdemucs
WHISPER_MODEL=medium
WHISPER_DEVICE=auto
MAX_VIDEO_HEIGHT=720
# Only for the HTTPS profile (docker compose --profile https up -d)
DOMAIN=karaoke.example.com
